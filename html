  <script>
    const SALARY = 65000;
    const RENT_DUE = 18000;
    const RENT_DAYS = 4;

    let roastMode = 'savage'; // 'pyaar' | 'mild' | 'savage'
    let spendChart = null;

    const state = {
      transactions: [
        { id: 1, merchant: 'Zomato', amount: 640, category: 'Food Delivery', time: 'Today, 1:45 PM', vpa: 'zomato@okaxis', roastTag: 'Biryani again? 🍗' },
        { id: 2, merchant: 'Myntra', amount: 3299, category: 'Shopping', time: 'Yesterday, 9:20 PM', vpa: 'myntra@icici', roastTag: 'End of Reason Sale victim 🛍️' },
        { id: 3, merchant: 'Swiggy', amount: 520, category: 'Food Delivery', time: '19 Nov, 11:15 PM', vpa: 'swiggy@hdfcbank', roastTag: '11 PM cravings tax 🌙' },
        { id: 4, merchant: 'Zepto', amount: 890, category: 'Quick Commerce', time: '18 Nov, 6:10 PM', vpa: 'zepto@ybl', roastTag: '10-min delivery, 10-sec regret ⚡' },
        { id: 5, merchant: 'Uber Auto', amount: 245, category: 'Commute', time: '17 Nov, 10:05 AM', vpa: 'uber@axisbank', roastTag: 'Metro bhi chalti hai bhai 🚇' },
        { id: 6, merchant: 'Zomato', amount: 1890, category: 'Food Delivery', time: '15 Nov, 8:40 PM', vpa: 'zomato@okaxis', roastTag: 'Weekend party sponsor 🍕' },
        { id: 7, merchant: 'Airtel Fiber', amount: 999, category: 'Entertainment', time: '10 Nov, 12:00 PM', vpa: 'airtel@okicici', roastTag: 'WiFi zaroori hai ✅' },
        { id: 8, merchant: 'Blue Tokai', amount: 380, category: 'Food Delivery', time: '08 Nov, 4:30 PM', vpa: 'bluetokai@ybl', roastTag: '₹380 ki coffee? Ambani ho? ☕' }
      ],
      messages: [
        {
          sender: 'bot',
          text: 'Bhai ₹3,430 sirf Food Delivery pe uda diya is hafte, aur 4 din mein ₹18,000 ka rent due hai. Zomato ka CEO tera naam apne will mein likhega kya? 😭🔥'
        }
      ]
    };

    const formatINR = (num) => '₹' + Number(num).toLocaleString('en-IN');

    function getTotals() {
      const totalSpent = state.transactions.reduce((sum, t) => sum + t.amount, 0);
      const remaining = Math.max(0, SALARY - totalSpent);
      const safeToSpend = Math.max(0, remaining - RENT_DUE);
      const foodSpend = state.transactions
        .filter((t) => t.category === 'Food Delivery')
        .reduce((sum, t) => sum + t.amount, 0);
      const shoppingSpend = state.transactions
        .filter((t) => t.category === 'Shopping')
        .reduce((sum, t) => sum + t.amount, 0);
      return { totalSpent, remaining, safeToSpend, foodSpend, shoppingSpend };
    }

    function generateRoast({ merchant, amount, category }) {
      const { totalSpent, safeToSpend, foodSpend } = getTotals();
      const ruleFood = document.getElementById('rule-food').checked;
      const ruleRent = document.getElementById('rule-rent').checked;

      if (ruleRent && safeToSpend < 3000) {
        if (roastMode === 'pyaar') {
          return `Heads up dost! ${merchant} pe ${formatINR(amount)} gaya. Ab sirf ${formatINR(safeToSpend)} safe bacha hai rent (${formatINR(RENT_DUE)}) ke baad. Thoda sambhal ke! 🫶`;
        }
        if (roastMode === 'mild') {
          return `${merchant} pe ${formatINR(amount)}? Bhai ${RENT_DAYS} din mein rent dena hai aur safe balance sirf ${formatINR(safeToSpend)} bacha hai. Landlord ko Zomato coupon dega kya? 😅`;
        }
        return `OYE! ${merchant} pe ${formatINR(amount)} aur uda diya?! Safe balance sirf ${formatINR(safeToSpend)} bacha hai aur ${RENT_DAYS} din mein ₹18k rent hai. Ab kya footpath pe WiFi lagwayega? 🚨🔥`;
      }

      if (ruleFood && category === 'Food Delivery' && foodSpend > 2000) {
        if (roastMode === 'pyaar') {
          return `${merchant} se ${formatINR(amount)} ka order! Is mahine food delivery ${formatINR(foodSpend)} ho gaya hai — ghar pe dal-chawal try karein? 🍲`;
        }
        if (roastMode === 'mild') {
          return `Phir se ${merchant} (${formatINR(amount)})? Tera food delivery bill ${formatINR(foodSpend)} cross kar gaya hai. Kitchen sirf Maggie banane ke liye rakha hai kya? 🍜`;
        }
        return `Bhai ${merchant} pe ${formatINR(amount)} aur?! Total ${formatINR(foodSpend)} khane mein phoonk diya! Teri mummy ko screenshot bhejun ya tu khud tiffin lagwa raha hai? 💀`;
      }

      if (category === 'Shopping' && amount >= 1500) {
        if (roastMode === 'pyaar') {
          return `${merchant} pe ${formatINR(amount)} ki shopping! Hope zaroori tha — ab is hafte thoda no-spend challenge rakhte hain. ✨`;
        }
        if (roastMode === 'mild') {
          return `${merchant} pe ${formatINR(amount)}! "Sale chal rahi thi" bolke wallet ka murder kar diya na? 🛍️`;
        }
        return `${merchant} pe ${formatINR(amount)}?! Salary 1st ko aati hai aur 20th tak tu gareeb ho jata hai, yahi reason hai! Kapde pehan ke kahan jayega jab metro ke paise nahi bachenge? 😭`;
      }

      if (roastMode === 'pyaar') {
        return `${merchant} pe ${formatINR(amount)} note kar liya hai. Safe-to-spend ab ${formatINR(safeToSpend)} hai. 👍`;
      }
      if (roastMode === 'mild') {
        return `${merchant} pe ${formatINR(amount)} gaya. Total kharcha ${formatINR(totalSpent)} pahunch gaya hai, dhyaan rakh! 👀`;
      }
      return `${merchant} pe ${formatINR(amount)}? Chhote-chhote kharche hi tera bank balance kha rahe hain bhai. Safe balance: ${formatINR(safeToSpend)}. 💸`;
    }

    function generateChatReply(userText) {
      const q = userText.toLowerCase();
      const { safeToSpend, foodSpend, shoppingSpend, totalSpent } = getTotals();

      if (q.includes('dinner') || q.includes('afford') || q.includes('khana') || q.includes('swiggy') || q.includes('zomato')) {
        if (safeToSpend < 800) {
          return roastMode === 'pyaar'
            ? `Abhi safe balance sirf ${formatINR(safeToSpend)} hai rent ke baad. Aaj ghar pe kuch bana lo, weekend pe treat kar lena! 🫶`
            : `Dinner? Bhai safe balance ${formatINR(safeToSpend)} bacha hai aur already ${formatINR(foodSpend)} Zomato/Swiggy pe uda chuka hai! Aaj chupchaap Maggi bana le. 🍜🔥`;
        }
        return roastMode === 'savag
